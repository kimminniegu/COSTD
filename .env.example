# 이 파일을 복사해 .env 를 만들고 값을 채우세요. (.env 는 Git에 올라가지 않습니다)
# 새 환경변수가 필요하면 이 파일에 "이름만" 추가하고 실제 값은 쓰지 않습니다.
# Render 배포 시에는 이 파일·.env 를 쓰지 않고 서비스별 환경변수에 넣습니다. 메인/챗봇 구분: docs/deploy_render.md
FLASK_SECRET_KEY=
FLASK_DEBUG=1
FLASK_PORT=5000

OPENAI_API_KEY=          # 메인(개발요청서 자동변환)과 챗봇 서버 모두 필요
REQUISITION_OPENAI_MODEL= # (선택) 개발요청서 변환 모델, 기본 gpt-4.1
OTHER_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_HOST=k-beauty-cosmetic-ingredients.p.rapidapi.com

# --- 로그인 (PM) : 첫 실행 시 계정이 없으면 이 값으로 데모 계정을 만듭니다 ---
COSMOA_DEMO_EMAIL=
COSMOA_DEMO_PASSWORD=
COSMOA_DEMO_NAME=
COSMOA_DEMO_TEAM=
# 운영(COSMOA_ENV=production 또는 Render)에서는 EMAIL·PASSWORD 가 비어 있거나 공개 기본값이면 계정을 만들지 않습니다.
# 이미 만들어진 계정은 이 값을 바꿔도 비밀번호가 바뀌지 않습니다 → python -m src.common.auth set-password <email> (로컬)
# Render 무료 서비스는 재시작·재배포 때 계정 DB가 새로 만들어지므로 이 값으로 다시 생성됩니다.

# --- 홈 (A) : src/01_home/home.md 4장·5장·8장 ---
EXIM_API_KEY=            # 한국수출입은행 현재환율 API 인증키
DATA_GO_KR_KEY=          # 공공데이터포털 인증키 (관세청 수출입실적, KOTRA)
KOTRA_NEWS_URL=          # (선택) KOTRA 단신속보뉴스 요청 주소 — 기술문서 확인 후 입력
COSMETIC_HS_CODES=3304 # (선택) 화장품 HS 코드, 쉼표 구분. 예: 3303,3304,3305,3307

# --- 규제 (B) : 서버 로컬 OCR (Tesseract). 비우면 PATH/기본 설치 경로에서 찾음. src/02_regulatory/regulatory.md 13항 ---
TESSERACT_CMD=
TESSDATA_PREFIX=

# 식약처 화장품 사용제한 원료정보 API 인증키 (Decoding)
MFDS_API_KEY=
MFDS_DB_PATH=            # (선택) 식약처 수집 DB 경로. 비우면 instance/regulatory/mfds_use_restriction.sqlite. Render 경로는 docs/deploy_render.md

# --- AI 챗봇 (F) : src/06_chatbot/chatbot.md 13항. 본 서버(app.py)는 챗봇 연결에 CHATBOT_URL / CHATBOT_SECRET 사용 (OPENAI_API_KEY 는 개발요청서용으로 별도 필요) ---
CHATBOT_URL=             # 챗봇 서버 주소 (로컬: http://127.0.0.1:5100, Render: https://<서비스명>.onrender.com)
CHATBOT_SECRET=          # 본 서버 ↔ 챗봇 서버 공유 비밀값 (양쪽에 같은 값)
CHATBOT_OPENAI_MODEL=    # (챗봇 서버) 기본 gpt-4.1
CHATBOT_PORT=            # (챗봇 서버 로컬 실행) 기본 5100
CHATBOT_DB_PATH=         # (챗봇 서버, 선택) 홈 데이터 캐시 SQLite 경로. 비우면 instance/cosmoa.db

# --- 배포 ---
COSMOA_ENV=              # 운영이면 production (Dockerfile 에 설정됨. 로컬에서는 비워 둠)
