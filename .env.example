# 이 파일을 복사해 .env 를 만들고 값을 채우세요. (.env 는 Git에 올라가지 않습니다)
# 새 환경변수가 필요하면 이 파일에 "이름만" 추가하고 실제 값은 쓰지 않습니다.
FLASK_SECRET_KEY=
FLASK_DEBUG=1
FLASK_PORT=5000

OPENAI_API_KEY=
OTHER_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_HOST=k-beauty-cosmetic-ingredients.p.rapidapi.com

# --- 로그인 (PM) : 첫 실행 시 계정이 없으면 이 값으로 데모 계정을 만듭니다 ---
COSMOA_DEMO_EMAIL=
COSMOA_DEMO_PASSWORD=
COSMOA_DEMO_NAME=
COSMOA_DEMO_TEAM=

# --- 홈 (A) : src/01_home/home.md 4장·5장·8장 ---
EXIM_API_KEY=            # 한국수출입은행 현재환율 API 인증키
DATA_GO_KR_KEY=          # 공공데이터포털 인증키 (관세청 수출입실적, KOTRA)
KOTRA_NEWS_URL=          # (선택) KOTRA 단신속보뉴스 요청 주소 — 기술문서 확인 후 입력
COSMETIC_HS_CODES=3304 # (선택) 화장품 HS 코드, 쉼표 구분. 예: 3303,3304,3305,3307

# --- 규제 (B) : 서버 로컬 OCR (Tesseract). 비우면 PATH/기본 설치 경로에서 찾음. src/02_regulatory/regulatory.md 13항 ---
TESSERACT_CMD=
TESSDATA_PREFIX=
